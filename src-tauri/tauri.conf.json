{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI CLI Auth Manager",
  "version": "0.1.0",
  "identifier": "com.local.aicliauthmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI CLI Auth Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
